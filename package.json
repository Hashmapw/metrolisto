{
  "name": "metrolisto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "pnpm build && cap sync",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:ios": "pnpm cap:sync:ios && cap open ios",
    "cap:android": "pnpm cap:sync:android && cap open android",
    "test": "vitest run",
    "format": "prettier --write src scripts docs *.json *.ts *.yaml *.md index.html",
    "format:check": "prettier --check src scripts docs *.json *.ts *.yaml *.md index.html"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdesign-mobile-react": "^0.23.3",
    "lucide-react": "^0.468.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "prettier": "^3.6.2"
  }
}
